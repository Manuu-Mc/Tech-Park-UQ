        tabla.getColumns().addAll(cNombre, cTipo, cEstado, cTiempo, cPuntos, cEliminar);

        Label info = new Label("Agrega atracciones desde la pestaña 'Atracciones'. "
                + "Recibirás notificaciones cuando cambien de estado o tengan tiempos de espera bajos.");
        info.setStyle("-fx-font-size: 12px; -fx-text-fill: #666;");
        info.setWrapText(true);
        
        Button btnActualizar = new Button("Actualizar Tiempos");
