package co.edu.uniquindio.poo.techparkuq.view;

import co.edu.uniquindio.poo.techparkuq.controller.ParqueController;
import co.edu.uniquindio.poo.techparkuq.controller.VisitanteController;
import co.edu.uniquindio.poo.techparkuq.model.entities.Atraccion;
import co.edu.uniquindio.poo.techparkuq.model.entities.Visitante;
import co.edu.uniquindio.poo.techparkuq.model.enums.EstadoAcceso;
import co.edu.uniquindio.poo.techparkuq.model.records.Notificacion;
import co.edu.uniquindio.poo.techparkuq.model.records.RegistroAcceso;
import javafx.beans.property.SimpleObjectProperty;
import javafx.beans.property.SimpleStringProperty;
import javafx.geometry.Insets;
import javafx.geometry.Pos;
import javafx.scene.Scene;
import javafx.scene.control.*;
import javafx.scene.control.cell.PropertyValueFactory;
import javafx.scene.layout.*;
import javafx.stage.Stage;

public class VisitanteView {

    private final Stage stage;
    private final Visitante visitante;
    private final VisitanteController controller;

    // Labels reactivos globales
    private Label lblSaldoTienda;
    private Label lblPuntosTienda;
    private Label lblSaldoAtracciones;
    private Label lblPuntosAtracciones;
    private Label lblTicketAtracciones;
    private Label lblSaldoPerfil;
    private Label lblPuntosPerfil;
    
    // Labels reactivos para Tienda de Puntos
    private Label lblTicketActual;
    private Label lblBeneficioTicket;
    private VBox cardPaqueteBasico;
    private VBox cardPaqueteEstandar;
    private VBox cardPaquetePremium;

    public VisitanteView(Stage stage, Visitante visitante, ParqueController parqueController) {
        this.stage = stage;
        this.visitante = visitante;
        this.controller = new VisitanteController(visitante, parqueController);
    }

    public Scene crearEscena() {
        BorderPane root = new BorderPane();
        root.setTop(crearHeader());
        root.setCenter(crearTabs());
        Scene scene = new Scene(root, 1920, 1080);
        scene.getStylesheets().add(getClass().getResource("/styles/modern-tables.css").toExternalForm());
        scene.getStylesheets().add(getClass().getResource("/styles/modern-tabs.css").toExternalForm());
        return scene;
    }

    // ─── HEADER ──────────────────────────────────────────────────────────────

    private VBox crearHeader() {
        VBox header = new VBox();
        header.setPadding(new Insets(20, 30, 20, 30));
        header.setStyle("-fx-background-color: linear-gradient(to right, #4527A0, #5E35B1);");

        HBox topRow = new HBox(20);
        topRow.setAlignment(Pos.CENTER_LEFT);
        
        Label titulo = new Label("Tech-Park UQ");
        titulo.setStyle("-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;");
        
        Region spacer = new Region();
        HBox.setHgrow(spacer, javafx.scene.layout.Priority.ALWAYS);
        
        Label bienvenida = new Label("Hola, " + visitante.getNombre());
        bienvenida.setStyle("-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;");

        Button btnCerrarSesion = new Button("Cerrar Sesi\u00f3n");
        btnCerrarSesion.setStyle("-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; "
                + "-fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 25; -fx-background-radius: 20; "
                + "-fx-border-color: white; -fx-border-width: 1.5; -fx-border-radius: 20;");
        btnCerrarSesion.setOnMouseEntered(e -> btnCerrarSesion.setStyle("-fx-background-color: rgba(255,255,255,0.3); -fx-text-fill: white; "
                + "-fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 25; -fx-background-radius: 20; "
                + "-fx-border-color: white; -fx-border-width: 1.5; -fx-border-radius: 20; -fx-cursor: hand;"));
        btnCerrarSesion.setOnMouseExited(e -> btnCerrarSesion.setStyle("-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; "
                + "-fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 25; -fx-background-radius: 20; "
                + "-fx-border-color: white; -fx-border-width: 1.5; -fx-border-radius: 20;"));
        btnCerrarSesion.setOnAction(e -> {
            LoginView loginView = new LoginView(stage, controller.getParqueController());
            stage.setScene(loginView.crearEscena());
        });
        
        topRow.getChildren().addAll(titulo, spacer, bienvenida, btnCerrarSesion);
        header.getChildren().add(topRow);
        return header;
    }

    private Label chip(String texto, String color) {
        Label l = new Label(texto);
        l.setStyle("-fx-background-color: " + color + "; -fx-text-fill: white; "
                + "-fx-font-weight: bold; -fx-font-size: 13px; "
                + "-fx-padding: 4 14; -fx-background-radius: 20;");
        return l;
    }

    private void refrescarTodo() {
        if (lblSaldoTienda != null) lblSaldoTienda.setText("$" + fmt(visitante.getSaldoVirtual()));
        if (lblPuntosTienda != null) lblPuntosTienda.setText(String.valueOf(visitante.getPuntosTicket()) + " pts");
        if (lblSaldoAtracciones != null) lblSaldoAtracciones.setText("$" + fmt(visitante.getSaldoVirtual()));
        if (lblPuntosAtracciones != null) lblPuntosAtracciones.setText(String.valueOf(visitante.getPuntosTicket()) + " pts");
        if (lblTicketAtracciones != null) lblTicketAtracciones.setText(visitante.getTipoTicket().getNombre());
        if (lblSaldoPerfil != null) lblSaldoPerfil.setText("$" + fmt(visitante.getSaldoVirtual()));
        if (lblPuntosPerfil != null) lblPuntosPerfil.setText(String.valueOf(visitante.getPuntosTicket()));
        
        // Actualizar tienda de puntos
        if (lblTicketActual != null) {
            lblTicketActual.setText(visitante.getTipoTicket().getNombre());
        }
        if (lblBeneficioTicket != null) {
            actualizarBeneficioTicket();
        }
        if (cardPaqueteBasico != null) {
            actualizarPaquetes();
        }
    }

    // ─── TABS ─────────────────────────────────────────────────────────────────

    private TabPane crearTabs() {
        TabPane tp = new TabPane();
        tp.setTabClosingPolicy(TabPane.TabClosingPolicy.UNAVAILABLE);
        tp.getTabs().addAll(
                tabPerfil(),
                tabTienda(),
                tabTiendaPuntos(),
                tabAtracciones(),
                tabMapaParque(),
                tabFavoritos(),
                tabEstadisticas(),
                tabNotificaciones()
        );
        return tp;
    }

    // ─── TAB PERFIL ───────────────────────────────────────────────────────────

    private Tab tabPerfil() {
        Tab tab = new Tab("Mi Perfil");

        VBox root = new VBox(20);
        root.setPadding(new Insets(30));
        root.setStyle("-fx-background-color: #FAFAFA;");

        // Tarjeta de datos personales
        VBox cardPersonal = new VBox(15);
        cardPersonal.setStyle("-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 12; "
                + "-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);");
        
        Label tituloPersonal = new Label("Informacion Personal");
        tituloPersonal.setStyle("-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #4527A0;");
        
        GridPane datos = new GridPane();
        datos.setHgap(25);
        datos.setVgap(15);
        agregarFila(datos, "Nombre:", visitante.getNombre(), 0);
        agregarFila(datos, "Cedula:", visitante.getCedula(), 1);
        agregarFila(datos, "Edad:", visitante.getEdad() + " a\u00f1os", 2);
        agregarFila(datos, "Estatura:", visitante.getEstatura() + " m", 3);
        
        cardPersonal.getChildren().addAll(tituloPersonal, new Separator(), datos);

        // Tarjeta de billetera
        VBox cardBilletera = new VBox(15);
        cardBilletera.setStyle("-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 12; "
                + "-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);");
        
        Label tituloBilletera = new Label("Billetera Virtual");
        tituloBilletera.setStyle("-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #4527A0;");
        
        lblSaldoPerfil = new Label("$" + fmt(visitante.getSaldoVirtual()));
        lblSaldoPerfil.setStyle("-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2E7D32;");
        
        Label lblSaldoDesc = new Label("Saldo disponible");
        lblSaldoDesc.setStyle("-fx-font-size: 13px; -fx-text-fill: #666;");

        Button btnRecargar = new Button("Recargar Saldo");
        btnRecargar.setStyle("-fx-background-color: #43A047; -fx-text-fill: white; "
                + "-fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 30; -fx-background-radius: 8;");
        btnRecargar.setOnMouseEntered(e -> btnRecargar.setStyle("-fx-background-color: #2E7D32; -fx-text-fill: white; "
                + "-fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 30; -fx-background-radius: 8; -fx-cursor: hand;"));
        btnRecargar.setOnMouseExited(e -> btnRecargar.setStyle("-fx-background-color: #43A047; -fx-text-fill: white; "
                + "-fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 30; -fx-background-radius: 8;"));
        btnRecargar.setOnAction(e -> {
            TextInputDialog d = new TextInputDialog();
            d.setTitle("Recargar Saldo");
            d.setHeaderText(null);
            d.setContentText("Monto a recargar ($):");
            d.showAndWait().ifPresent(v -> {
                try {
                    controller.recargarSaldo(Float.parseFloat(v));
                    refrescarTodo();
                } catch (NumberFormatException ex) {
                    alerta("Error", "Ingrese un numero valido", Alert.AlertType.ERROR);
                }
            });
        });
        
        cardBilletera.getChildren().addAll(tituloBilletera, new Separator(), lblSaldoDesc, lblSaldoPerfil, btnRecargar);

        // Tarjeta de puntos
        VBox cardPuntos = new VBox(15);
        cardPuntos.setStyle("-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 12; "
                + "-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);");
        
        Label tituloPuntos = new Label("Sistema de Puntos");
        tituloPuntos.setStyle("-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #4527A0;");
        
        lblPuntosPerfil = new Label(String.valueOf(visitante.getPuntosTicket()));
        lblPuntosPerfil.setStyle("-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #E65100;");
        
        Label lblPuntosDesc = new Label("Puntos acumulados");
        lblPuntosDesc.setStyle("-fx-font-size: 13px; -fx-text-fill: #666;");
        
        Label lblPuntosInfo = new Label("Usa tus puntos para acceder a las atracciones del parque");
        lblPuntosInfo.setStyle("-fx-font-size: 12px; -fx-text-fill: #999;");
        lblPuntosInfo.setWrapText(true);
        
        cardPuntos.getChildren().addAll(tituloPuntos, new Separator(), lblPuntosDesc, lblPuntosPerfil, lblPuntosInfo);

        root.getChildren().addAll(cardPersonal, cardBilletera, cardPuntos);

        ScrollPane sp = new ScrollPane(root);
        sp.setFitToWidth(true);
        sp.setStyle("-fx-background-color: #FAFAFA;");
        tab.setContent(sp);
        return tab;
    }

    // ─── TAB TIENDA ───────────────────────────────────────────────────────────

    private Tab tabTienda() {
        Tab tab = new Tab("Tienda de Tickets");

        VBox root = new VBox(25);
        root.setPadding(new Insets(30));
        root.setStyle("-fx-background-color: #FAFAFA;");

        // Tarjeta de estado de cuenta
        VBox cardEstado = new VBox(15);
        cardEstado.setStyle("-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; "
                + "-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);");
        
        Label tituloEstado = new Label("Estado de Cuenta");
        tituloEstado.setStyle("-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #4527A0;");
        
        HBox estadoBox = new HBox(20);
        estadoBox.setAlignment(Pos.CENTER_LEFT);
        
        VBox saldoBox = new VBox(5);
        Label lblSaldoTit = new Label("Saldo Disponible");
        lblSaldoTit.setStyle("-fx-font-size: 12px; -fx-text-fill: #666;");
        lblSaldoTienda = new Label("$" + fmt(visitante.getSaldoVirtual()));
        lblSaldoTienda.setStyle("-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #43A047;");
        saldoBox.getChildren().addAll(lblSaldoTit, lblSaldoTienda);
        
        VBox puntosBox = new VBox(5);
        Label lblPuntosTit = new Label("Puntos Acumulados");
        lblPuntosTit.setStyle("-fx-font-size: 12px; -fx-text-fill: #666;");
        lblPuntosTienda = new Label(String.valueOf(visitante.getPuntosTicket()) + " pts");
        lblPuntosTienda.setStyle("-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #FB8C00;");
        puntosBox.getChildren().addAll(lblPuntosTit, lblPuntosTienda);
        
        estadoBox.getChildren().addAll(saldoBox, new Separator(javafx.geometry.Orientation.VERTICAL) {{
            setPrefHeight(50);
        }}, puntosBox);
        
        cardEstado.getChildren().addAll(tituloEstado, new Separator(), estadoBox);

        // Título de tickets
        Label tituloTickets = new Label("Elige tu Ticket");
        tituloTickets.setStyle("-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #4527A0;");

        // Cards de tickets
        HBox cards = new HBox(20);
        cards.setAlignment(Pos.CENTER);

        cards.getChildren().addAll(
                cardTicket("Ticket General", "$50,000", "#1565C0",
                        "Acceso al parque\nSin beneficios adicionales\nCompra puntos en la tienda",
                        e -> { controller.comprarTicketGeneral(); refrescarTodo(); }),
                cardTicket("Ticket Familiar", "$150,000", "#6A1B9A",
                        "Hasta 4 personas\n25% descuento en puntos\nCompra puntos con descuento",
                        e -> { controller.comprarTicketFamiliar(); refrescarTodo(); }),
                cardTicket("Fast-Pass", "$80,000", "#BF360C",
                        "Prioridad en todas las colas\nSin costos adicionales\nCompra puntos en la tienda",
                        e -> { controller.comprarTicketFastPass(); refrescarTodo(); })
        );

        root.getChildren().addAll(cardEstado, tituloTickets, cards);

        ScrollPane sp = new ScrollPane(root);
        sp.setFitToWidth(true);
        sp.setStyle("-fx-background-color: #FAFAFA;");
        tab.setContent(sp);
        return tab;
    }

    private VBox cardTicket(String nombre, String precio, String color,
                            String desc, javafx.event.EventHandler<javafx.event.ActionEvent> h) {
        VBox card = new VBox(15);
        card.setPrefWidth(280);
        card.setAlignment(Pos.TOP_CENTER);
        card.setStyle("-fx-background-color: white; -fx-border-color: " + color
                + "; -fx-border-width: 3; -fx-padding: 25; -fx-background-radius: 12; -fx-border-radius: 12; "
                + "-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);");

        Label lNombre = new Label(nombre);
        lNombre.setStyle("-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: " + color + ";");

        Label lPrecio = new Label(precio);
        lPrecio.setStyle("-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #212121;");

        Label lDesc = new Label(desc);
        lDesc.setWrapText(true);
        lDesc.setAlignment(Pos.CENTER);
        lDesc.setStyle("-fx-font-size: 13px; -fx-text-fill: #666;");

        Button btn = new Button("Comprar");
        btn.setStyle("-fx-background-color: " + color + "; -fx-text-fill: white; "
                + "-fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 40; -fx-background-radius: 8;");
        btn.setMaxWidth(Double.MAX_VALUE);
        btn.setOnMouseEntered(e -> btn.setStyle("-fx-background-color: derive(" + color + ", -20%); -fx-text-fill: white; "
                + "-fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 40; -fx-background-radius: 8; -fx-cursor: hand;"));
        btn.setOnMouseExited(e -> btn.setStyle("-fx-background-color: " + color + "; -fx-text-fill: white; "
                + "-fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 40; -fx-background-radius: 8;"));
        btn.setOnAction(h);

        card.getChildren().addAll(lNombre, lPrecio, new Separator(), lDesc, btn);
        return card;
    }

    // ─── TAB TIENDA PUNTOS ────────────────────────────────────────────────────

    private Tab tabTiendaPuntos() {
        Tab tab = new Tab("Tienda de Puntos");

        VBox root = new VBox(25);
        root.setPadding(new Insets(30));
        root.setStyle("-fx-background-color: #FAFAFA;");

        // Tarjeta de información del ticket
        VBox cardTicket = new VBox(15);
        cardTicket.setStyle("-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; "
                + "-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);");
        
        Label tituloTicket = new Label("Tu Ticket Actual");
        tituloTicket.setStyle("-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #4527A0;");
        
        HBox ticketInfo = new HBox(20);
        ticketInfo.setAlignment(Pos.CENTER_LEFT);
        
        lblTicketActual = new Label(visitante.getTipoTicket().getNombre());
        lblTicketActual.setStyle("-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1976D2;");
        
        lblBeneficioTicket = new Label();
        actualizarBeneficioTicket();
        
        ticketInfo.getChildren().addAll(lblTicketActual, lblBeneficioTicket);
        
        cardTicket.getChildren().addAll(tituloTicket, new Separator(), ticketInfo);

        // Título de paquetes
        Label tituloPaquetes = new Label("Paquetes de Puntos Disponibles");
        tituloPaquetes.setStyle("-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #4527A0;");

        // Cards de paquetes de puntos
        HBox paquetesBox = new HBox(20);
        paquetesBox.setAlignment(Pos.CENTER);

        cardPaqueteBasico = cardPaquetePuntos("Paquete Básico", 50, "#1565C0");
        cardPaqueteEstandar = cardPaquetePuntos("Paquete Estándar", 100, "#6A1B9A");
        cardPaquetePremium = cardPaquetePuntos("Paquete Premium", 200, "#BF360C");

        paquetesBox.getChildren().addAll(cardPaqueteBasico, cardPaqueteEstandar, cardPaquetePremium);

        root.getChildren().addAll(cardTicket, tituloPaquetes, paquetesBox);

        ScrollPane sp = new ScrollPane(root);
        sp.setFitToWidth(true);
        sp.setStyle("-fx-background-color: #FAFAFA;");
        tab.setContent(sp);
        return tab;
    }

    private VBox cardPaquetePuntos(String nombre, int puntos, String color) {
        VBox card = new VBox(15);
        card.setPrefWidth(280);
        card.setAlignment(Pos.TOP_CENTER);
        card.setStyle("-fx-background-color: white; -fx-border-color: " + color
                + "; -fx-border-width: 3; -fx-padding: 25; -fx-background-radius: 12; -fx-border-radius: 12; "
                + "-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);");

        Label lNombre = new Label(nombre);
        lNombre.setStyle("-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: " + color + ";");

        Label lPuntos = new Label(puntos + " PUNTOS");
        lPuntos.setStyle("-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #212121;");

        float precioBase = puntos * 100;
        float precioFinal = visitante.calcularPrecioPuntos(puntos);
        int descuento = visitante.getDescuentoPuntos();

        VBox precioBox = new VBox(5);
        precioBox.setAlignment(Pos.CENTER);

        if (descuento > 0) {
            Label lPrecioOriginal = new Label("$" + String.format("%.0f", precioBase));
            lPrecioOriginal.setStyle("-fx-font-size: 14px; -fx-text-fill: #999; -fx-strikethrough: true;");
            
            Label lPrecioFinal = new Label("$" + String.format("%.0f", precioFinal));
            lPrecioFinal.setStyle("-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #4CAF50;");
            
            Label lDescuento = new Label("-" + descuento + "% DESCUENTO");
            lDescuento.setStyle("-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #4CAF50;");
            
            precioBox.getChildren().addAll(lPrecioOriginal, lPrecioFinal, lDescuento);
        } else {
            Label lPrecio = new Label("$" + String.format("%.0f", precioFinal));
            lPrecio.setStyle("-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #212121;");
            precioBox.getChildren().add(lPrecio);
        }

        Button btn = new Button("COMPRAR");
        btn.setStyle("-fx-background-color: " + color + "; -fx-text-fill: white; "
                + "-fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 40; -fx-background-radius: 8;");
        btn.setMaxWidth(Double.MAX_VALUE);
        btn.setOnMouseEntered(e -> btn.setStyle("-fx-background-color: derive(" + color + ", -20%); -fx-text-fill: white; "
                + "-fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 40; -fx-background-radius: 8; -fx-cursor: hand;"));
        btn.setOnMouseExited(e -> btn.setStyle("-fx-background-color: " + color + "; -fx-text-fill: white; "
                + "-fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 40; -fx-background-radius: 8;"));
        btn.setOnAction(e -> {
            controller.comprarPuntos(puntos);
            refrescarTodo();
        });

        card.getChildren().addAll(lNombre, lPuntos, new Separator(), precioBox, btn);
        return card;
    }

    // ─── TAB ATRACCIONES ──────────────────────────────────────────────────────

    private Tab tabAtracciones() {
        Tab tab = new Tab("Atracciones");

        VBox root = new VBox(25);
        root.setPadding(new Insets(30));
        root.setStyle("-fx-background-color: #FAFAFA;");

        // Tarjeta de estado de cuenta
        VBox cardEstado = new VBox(15);
        cardEstado.setStyle("-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; "
                + "-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);");
        
        Label tituloEstado = new Label("Estado de Cuenta");
        tituloEstado.setStyle("-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #4527A0;");
        
        HBox estadoBox = new HBox(20);
        estadoBox.setAlignment(Pos.CENTER_LEFT);
        
        VBox ticketBox = new VBox(5);
        Label lblTicketTit = new Label("Ticket Activo");
        lblTicketTit.setStyle("-fx-font-size: 12px; -fx-text-fill: #666;");
        lblTicketAtracciones = new Label(visitante.getTipoTicket().getNombre());
        lblTicketAtracciones.setStyle("-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #4527A0;");
        ticketBox.getChildren().addAll(lblTicketTit, lblTicketAtracciones);
        
        VBox saldoBox = new VBox(5);
        Label lblSaldoTit = new Label("Saldo Disponible");
        lblSaldoTit.setStyle("-fx-font-size: 12px; -fx-text-fill: #666;");
        lblSaldoAtracciones = new Label("$" + fmt(visitante.getSaldoVirtual()));
        lblSaldoAtracciones.setStyle("-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #43A047;");
        saldoBox.getChildren().addAll(lblSaldoTit, lblSaldoAtracciones);
        
        VBox puntosBox = new VBox(5);
        Label lblPuntosTit = new Label("Puntos Acumulados");
        lblPuntosTit.setStyle("-fx-font-size: 12px; -fx-text-fill: #666;");
        lblPuntosAtracciones = new Label(String.valueOf(visitante.getPuntosTicket()) + " pts");
        lblPuntosAtracciones.setStyle("-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #FB8C00;");
        puntosBox.getChildren().addAll(lblPuntosTit, lblPuntosAtracciones);
        
        estadoBox.getChildren().addAll(ticketBox, new Separator(javafx.geometry.Orientation.VERTICAL) {{
            setPrefHeight(50);
        }}, saldoBox, new Separator(javafx.geometry.Orientation.VERTICAL) {{
            setPrefHeight(50);
        }}, puntosBox);
        
        cardEstado.getChildren().addAll(tituloEstado, new Separator(), estadoBox);

        // Tarjeta de atracciones
        VBox cardAtracciones = new VBox(15);
        cardAtracciones.setStyle("-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; "
                + "-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);");
        
        Label tituloAtracciones = new Label("Atracciones Disponibles");
        tituloAtracciones.setStyle("-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #4527A0;");

        TableView<Atraccion> tabla = new TableView<>(controller.getAtraccionesDisponibles());
        tabla.setColumnResizePolicy(TableView.CONSTRAINED_RESIZE_POLICY);
        tabla.setPrefHeight(400);

        TableColumn<Atraccion, String> cNombre = col("Atraccion", "nombre", 0);
        TableColumn<Atraccion, String> cTipo = col("Tipo", "tipoAtraccion", 0);
        TableColumn<Atraccion, String> cEstado = col("Estado", "estadoActual", 0);
        TableColumn<Atraccion, Integer> cPuntos = new TableColumn<>("Costo Pts");
        cPuntos.setCellValueFactory(new PropertyValueFactory<>("costoEnPuntos"));
        
        TableColumn<Atraccion, Integer> cTiempo = new TableColumn<>("Tiempo Espera");
        cTiempo.setCellValueFactory(new PropertyValueFactory<>("tiempoEspera"));
        cTiempo.setCellFactory(col -> new TableCell<>() {
            @Override
            protected void updateItem(Integer item, boolean empty) {
                super.updateItem(item, empty);
                if (empty || item == null) {
                    setText(null);
                    setStyle("");
                } else {
                    setText(item + " min");
                    if (item == 0) {
                        setStyle("-fx-text-fill: #4CAF50; -fx-font-weight: bold;");
                    } else if (item <= 10) {
                        setStyle("-fx-text-fill: #FF9800; -fx-font-weight: bold;");
                    } else {
                        setStyle("-fx-text-fill: #F44336; -fx-font-weight: bold;");
                    }
                }
            }
        });

        // Columna de acciones
        TableColumn<Atraccion, Void> cAccion = new TableColumn<>("Acciones");
        cAccion.setCellFactory(p -> new TableCell<>() {
            private final Button btnAcceso = new Button("Solicitar Acceso");
            private final Button btnFav = new Button("Favorito");
            private final HBox box = new HBox(6, btnAcceso, btnFav);

            {
                btnAcceso.setStyle("-fx-background-color: #1565C0; -fx-text-fill: white; -fx-font-size: 11px; -fx-padding: 6 12; -fx-background-radius: 6;");
                btnFav.setStyle("-fx-background-color: #FB8C00; -fx-text-fill: white; -fx-font-size: 11px; -fx-padding: 6 12; -fx-background-radius: 6;");

                btnAcceso.setOnAction(e -> {
                    Atraccion a = getTableView().getItems().get(getIndex());
                    controller.solicitarAccesoAtraccion(a);
                    refrescarTodo();
                });

                btnFav.setOnAction(e -> {
                    Atraccion a = getTableView().getItems().get(getIndex());
                    controller.agregarAtraccionFavorita(a);
                });
            }

            @Override
            protected void updateItem(Void item, boolean empty) {
                super.updateItem(item, empty);
                setGraphic(empty ? null : box);
            }
        });

        tabla.getColumns().addAll(cNombre, cTipo, cEstado, cPuntos, cTiempo, cAccion);

        Label info = new Label("Haz clic en 'Solicitar Acceso' para intentar ingresar a una atraccion usando tus puntos.");
        info.setStyle("-fx-font-size: 12px; -fx-text-fill: #666;");
        info.setWrapText(true);
        
        cardAtracciones.getChildren().addAll(tituloAtracciones, new Separator(), tabla, info);

        root.getChildren().addAll(cardEstado, cardAtracciones);
        tab.setContent(root);
        return tab;
    }

    // ─── TAB MAPA PARQUE ──────────────────────────────────────────────────────

    private Tab tabMapaParque() {
        Tab tab = new Tab("Mapa del Parque");

        VBox root = new VBox(25);
        root.setPadding(new Insets(30));
        root.setStyle("-fx-background-color: #FAFAFA;");

        Label titulo = new Label("Mapa Interactivo del Parque");
        titulo.setStyle("-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #4527A0;");

        // Tarjeta de mapa
        VBox cardMapa = new VBox(15);
        cardMapa.setStyle("-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; "
                + "-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);");

        Label subtitulo = new Label("Todas las Atracciones del Parque");
        subtitulo.setStyle("-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #4527A0;");

        TableView<Atraccion> tabla = new TableView<>(controller.getAtraccionesDisponibles());
        tabla.setColumnResizePolicy(TableView.CONSTRAINED_RESIZE_POLICY);
        tabla.setPrefHeight(500);

        TableColumn<Atraccion, String> cNombre = col("Atraccion", "nombre", 0);
        TableColumn<Atraccion, String> cTipo = col("Tipo", "tipoAtraccion", 0);
        
        TableColumn<Atraccion, String> cEstado = col("Estado", "estadoActual", 0);
        cEstado.setCellFactory(col -> new TableCell<>() {
            @Override
            protected void updateItem(String item, boolean empty) {
                super.updateItem(item, empty);
                if (empty || item == null) {
                    setText(null);
                    setStyle("");
                } else {
                    setText(item);
                    switch (item) {
                        case "ACTIVA" ->
                            setStyle("-fx-background-color: #C8E6C9; -fx-text-fill: #1B5E20; -fx-font-weight: bold; -fx-padding: 6; -fx-background-radius: 4;");
                        case "EN_MANTENIMIENTO" ->
                            setStyle("-fx-background-color: #FFE0B2; -fx-text-fill: #E65100; -fx-font-weight: bold; -fx-padding: 6; -fx-background-radius: 4;");
                        case "CERRADO" ->
                            setStyle("-fx-background-color: #FFCDD2; -fx-text-fill: #B71C1C; -fx-font-weight: bold; -fx-padding: 6; -fx-background-radius: 4;");
                    }
                }
            }
        });
        
        TableColumn<Atraccion, Integer> cTiempo = new TableColumn<>("Tiempo Espera");
        cTiempo.setCellValueFactory(new PropertyValueFactory<>("tiempoEspera"));
        cTiempo.setCellFactory(col -> new TableCell<>() {
            @Override
            protected void updateItem(Integer item, boolean empty) {
                super.updateItem(item, empty);
                if (empty || item == null) {
                    setText(null);
                    setStyle("");
                } else {
                    setText(item + " min");
                    if (item == 0) {
                        setStyle("-fx-text-fill: #4CAF50; -fx-font-weight: bold;");
                    } else if (item <= 10) {
                        setStyle("-fx-text-fill: #FF9800; -fx-font-weight: bold;");
                    } else {
                        setStyle("-fx-text-fill: #F44336; -fx-font-weight: bold;");
                    }
                }
            }
        });
        
        TableColumn<Atraccion, Integer> cCola = new TableColumn<>("Personas en Cola");
        cCola.setCellValueFactory(new PropertyValueFactory<>("personasEnCola"));
        
        TableColumn<Atraccion, Integer> cPuntos = new TableColumn<>("Costo Pts");
        cPuntos.setCellValueFactory(new PropertyValueFactory<>("costoEnPuntos"));
        
        TableColumn<Atraccion, Integer> cEdad = new TableColumn<>("Edad Min");
        cEdad.setCellValueFactory(new PropertyValueFactory<>("edadMinimaRequerida"));
        
        TableColumn<Atraccion, Float> cAltura = new TableColumn<>("Altura Min");
        cAltura.setCellValueFactory(new PropertyValueFactory<>("alturaMinimaRequerida"));
        cAltura.setCellFactory(col -> new TableCell<>() {
            @Override
            protected void updateItem(Float item, boolean empty) {
                super.updateItem(item, empty);
                if (empty || item == null) {
                    setText(null);
                } else {
                    setText(item + " m");
                }
            }
        });

        tabla.getColumns().addAll(cNombre, cTipo, cEstado, cTiempo, cCola, cPuntos, cEdad, cAltura);

        Label leyenda = new Label(
                "🟢 ACTIVA = Funcionando normalmente   |   "
                + "🟠 EN MANTENIMIENTO = Temporalmente cerrada   |   "
                + "🔴 CERRADO = No disponible");
        leyenda.setWrapText(true);
        leyenda.setStyle("-fx-font-size: 12px; -fx-text-fill: #666;");
        
        Button btnActualizar = new Button("Actualizar Tiempos de Espera");
        btnActualizar.setStyle("-fx-background-color: #4527A0; -fx-text-fill: white; "
                + "-fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 30; -fx-background-radius: 8;");
        btnActualizar.setOnMouseEntered(e -> btnActualizar.setStyle("-fx-background-color: #311B92; -fx-text-fill: white; "
                + "-fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 30; -fx-background-radius: 8; -fx-cursor: hand;"));
        btnActualizar.setOnMouseExited(e -> btnActualizar.setStyle("-fx-background-color: #4527A0; -fx-text-fill: white; "
                + "-fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 30; -fx-background-radius: 8;"));
        btnActualizar.setOnAction(e -> {
            tabla.refresh();
            alerta("Actualizado", "Los tiempos de espera se han actualizado correctamente.", Alert.AlertType.INFORMATION);
        });

        cardMapa.getChildren().addAll(subtitulo, new Separator(), tabla, leyenda, btnActualizar);
        root.getChildren().addAll(titulo, cardMapa);

        tab.setContent(root);
        return tab;
    }

    // ─── TAB FAVORITOS ────────────────────────────────────────────────────────

    private Tab tabFavoritos() {
        Tab tab = new Tab("Mis Favoritos");

        VBox root = new VBox(20);
        root.setPadding(new Insets(30));
        root.setStyle("-fx-background-color: #FAFAFA;");
        
        Label titulo = new Label("Mis Atracciones Favoritas");
        titulo.setStyle("-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #4527A0;");

        VBox cardFavoritos = new VBox(15);
        cardFavoritos.setStyle("-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; "
                + "-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);");

        TableView<Atraccion> tabla = new TableView<>(controller.getAtraccionesFavoritas());
